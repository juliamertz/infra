export TFDIR="$PWD/terraform"
export TALOSCONFIG="$PWD/talosconfig"

use_tofu() {
  env_file=$(mktemp)
  tofu output -json ENV | jq -r 'to_entries | .[] | "\(.key)=\(.value)"' > "$env_file"
  dotenv "$env_file"
  watch_file "$TFDIR/terraform.tfstate"
}

use_sops() {
  local path=${1:-"$PWD/secrets/tfvars.yaml"}
  sops -d "$path" | yq . | jq -r 'to_entries[] | "\(.key) = \(.value | tojson)"' > "$PWD/terraform/terraform.tfvars"
  watch_file "$path" 
}

use_awsrc() {
  if test -f .awsrc; then
    source .awsrc
  fi
  watch_file .awsrc
}

use flake
use tofu
use sops
use awsrc

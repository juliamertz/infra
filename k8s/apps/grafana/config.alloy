// vim:ft=hcl

discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["default", "grafana", "kube-system", "lightspeed-dhl-adapter"]
  }
}

discovery.kubernetes "nodes" {
  role = "node"
}

prometheus.scrape "kubelet" {
  targets      = discovery.kubernetes.nodes.targets
  job_name     = "kubelet"
  scheme       = "https"
  metrics_path = "/metrics"
  
  tls_config {
    ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = true
  }
  
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  
  forward_to = [prometheus.remote_write.victoria_metrics.receiver]
}

prometheus.scrape "cadvisor" {
  targets      = discovery.kubernetes.nodes.targets
  job_name     = "cadvisor"
  scheme       = "https"
  metrics_path = "/metrics/cadvisor"
  
  tls_config {
    ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = true
  }
  
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  
  forward_to = [prometheus.remote_write.victoria_metrics.receiver]
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets
  
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }
}

discovery.relabel "kubelet_metrics" {
  targets = discovery.kubernetes.nodes.targets
  
  rule {
    source_labels = ["__name__"]
    regex         = "kubelet_(node_name|running_pods|running_containers|volume_stats_.*|pod_start_duration_seconds.*)"
    action        = "keep"
  }
}

discovery.relabel "cadvisor_metrics" {
  targets = discovery.kubernetes.nodes.targets
  
  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|memory_usage_bytes|network_receive_bytes_total|network_transmit_bytes_total|fs_usage_bytes|fs_limit_bytes)"
    action        = "keep"
  }
  
  rule {
    source_labels = ["container"]
    regex         = "POD|"
    action        = "drop"
  }
  
  rule {
    source_labels = ["namespace"]
    regex         = "default|grafana|kube-system|lightspeed-dhl-adapter"
    action        = "keep"
  }
}

prometheus.scrape "pods" {
  targets    = discovery.relabel.pods.output
  job_name   = "kubernetes-pods"
  forward_to = [prometheus.remote_write.victoria_metrics.receiver]
}

prometheus.remote_write "victoria_metrics" {
  endpoint {
    url = "http://victoria-metrics-victoria-metrics-single-server:8428/api/v1/write"
  }
}
